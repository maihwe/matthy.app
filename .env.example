# Environment variables this project reads.
#
# 02 §8 and SEC-SEC-003: this file documents the shape and is committed; `.env`
# is git-ignored and is where the real values live. `config.env.require_env`
# fails the boot loudly on a missing variable rather than defaulting to
# something insecure (12 §4).
#
# Copy to `.env` and fill in. Generate the secret key with:
#     python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

# --- Core ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
# SEC-SEC-007: long, random, unique per environment. Never reused across
# environments, never committed. Its compromise forges sessions and tokens.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=Africa/Lagos

# --- Database (NFR-DATA-001) -----------------------------------------------
POSTGRES_DB=matthy
POSTGRES_USER=matthy
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
# Used only by config.settings.test, so a test run cannot truncate a
# development database.
POSTGRES_TEST_DB=test_matthy

# --- Redis: cache, broker, rate limits -------------------------------------
REDIS_URL=redis://localhost:6379/0
CACHE_KEY_PREFIX=ihweza

# --- Celery ----------------------------------------------------------------
CELERY_TIMEZONE=Africa/Lagos
CELERY_TASK_TIME_LIMIT_SECONDS=600
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=540

# --- Development only ------------------------------------------------------
EMAIL_HOST=localhost
EMAIL_PORT=1025

# --- Production only -------------------------------------------------------
# Left blank in development on purpose. There is no wildcard default for any
# of these: an origin that quietly works in production is a misconfiguration
# nobody notices. See config/settings/production.py.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HSTS_SECONDS=31536000
SESSION_IDLE_TIMEOUT_SECONDS=1800

# --- Secrets the later slices will require (declared now, read then) --------
# 10 §6.4 rate limits are configuration, not constants, so they can be
# tightened during an incident without a deploy.
RATELIMIT_LOGIN_PER_15MIN=10
RATELIMIT_OTP_ISSUE_PER_15MIN=3
RATELIMIT_PIN_PER_15MIN=5
RATELIMIT_PASSWORD_RESET_PER_HOUR=3
RATELIMIT_FINANCIAL_WRITES_PER_MIN=60

# SEC-SEC-008: webhook signing secrets are per-provider and per-environment,
# never shared. Populated with the payments slice.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
